{
  "name": "belajar-vibe-coding",
  "version": "1.0.0",
  "description": "Backend project with Bun, ElysiaJS, Drizzle ORM, and MySQL",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "bun --watch run src/index.ts",
    "start": "bun run src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@elysiajs/swagger": "^1.3.1",
    "drizzle-orm": "^0.38.4",
    "elysia": "^1.2.10",
    "mysql2": "^3.12.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.30.2",
    "typescript": "^5.0.0"
  }
}
